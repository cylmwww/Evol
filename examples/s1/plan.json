{
  "schema_version": 1,
  "name": "调整演示配置",
  "inputs": [
    "config.txt"
  ],
  "steps": [
    {
      "id": "read",
      "tool": "read_file",
      "args": {
        "path": "config.txt"
      }
    },
    {
      "id": "change",
      "tool": "replace_exact",
      "args": {
        "path": "config.txt",
        "old_utf8": "timeout=30",
        "new_utf8": "timeout=60"
      }
    },
    {
      "id": "verify",
      "tool": "assert_file_sha256",
      "args": {
        "path": "config.txt",
        "expected_from": "change"
      }
    }
  ]
}