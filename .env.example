EVOL_HOST=127.0.0.1
EVOL_PORT=8080
EVOL_DB_PATH=evol.db
EVOL_MAX_DIFF_BYTES=1048576
EVOL_MAX_STEPS=8
EVOL_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
EVOL_AUTH_REQUIRED=false
EVOL_AUTH_SECRET=
EVOL_BOOTSTRAP_ADMIN_USERNAME=
EVOL_BOOTSTRAP_ADMIN_PASSWORD=
EVOL_DEFAULT_TENANT_ID=default
EVOL_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
EVOL_LLM_PROVIDER=local

EVOL_ENABLED_AGENTS=lead,security,correctness-reliability,critic
EVOL_AGENT_TOKEN_BUDGET=8000
EVOL_AGENT_TIME_BUDGET_SECONDS=60
# Preflight semantic context budget. Keep input + output below the model window.
EVOL_AGENT_CONTEXT_WINDOW_TOKENS=32768
EVOL_AGENT_CONTEXT_INPUT_TOKENS=20000
EVOL_CONTEXT_DIFF_TOKEN_BUDGET=12000
EVOL_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
EVOL_CONTEXT_RECENT_OBSERVATIONS=2
EVOL_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
EVOL_LLM_INPUT_COST_PER_MILLION=0
EVOL_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
EVOL_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
EVOL_OPENROUTER_API_KEY=
EVOL_OPENROUTER_SITE_URL=
EVOL_OPENROUTER_APP_NAME=evol

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
EVOL_LLM_BASE_URL=
EVOL_LLM_API_KEY=
EVOL_LLM_MODEL=

# Replay evaluation and evolution activation gate
EVOL_EVAL_MAX_CASES=5
EVOL_EVAL_MIN_CASES=3
EVOL_EVAL_MIN_HOLDOUT_CASES=2
EVOL_EVAL_MIN_IMPROVEMENT=0.01
EVOL_EVAL_MAX_METRIC_REGRESSION=0
EVOL_EVALUATION_MIN_PUBLIC_PRS=300
EVOL_EVALUATION_MIN_F1_IMPROVEMENT=0.03
EVOL_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub integration
EVOL_GITHUB_WEBHOOK_SECRET=
EVOL_GITHUB_TOKEN=
EVOL_AUTO_POST_REVIEW=false
EVOL_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
EVOL_DATABASE_URL=
EVOL_REDIS_URL=
EVOL_ASYNC_WORKERS=2
EVOL_QUEUE_MAX_ATTEMPTS=3
EVOL_QUEUE_LEASE_SECONDS=60
EVOL_SKILLS_DIR=skills

# Repair verification and observability
EVOL_REPAIR_TEST_COMMAND=
EVOL_REPAIR_VERIFY_TIMEOUT_SECONDS=120
EVOL_MEMORY_ENABLED=true
EVOL_MEMORY_RECALL_LIMIT=6
EVOL_MEMORY_WORKING_TTL_SECONDS=86400
EVOL_OTEL_ENDPOINT=
EVOL_OTEL_SERVICE_NAME=evol
EVOL_ALERT_FAILURE_RATE=0.20
EVOL_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
EVOL_GITHUB_APP_ID=
EVOL_GITHUB_APP_SLUG=
EVOL_GITHUB_PRIVATE_KEY_PATH=
EVOL_PUBLIC_BASE_URL=http://127.0.0.1:8080
